# Copy these values into backend/.env. Never commit the real APIv3 key or private key.
WECHAT_PAY_MCH_ID=1711686534
WECHAT_PAY_API_V3_KEY=replace-with-your-32-character-api-v3-key
WECHAT_PAY_PRIVATE_KEY_PATH=D:\\path\\to\\apiclient_key.pem
WECHAT_PAY_MCH_SERIAL_NO=6062FED80AE8EF2894789FF6022D9C6EFA510798
WECHAT_PAY_ENABLED=false
WECHAT_PAY_NOTIFY_URL=https://mall.lebb.chat/api/v1/payments/wechat/notify
# Downloaded from WeChat Pay after APIv3 is configured. Required to verify payment notifications.
WECHAT_PAY_PLATFORM_CERT_PATH=D:\\path\\to\\wechatpay_platform_cert.pem
