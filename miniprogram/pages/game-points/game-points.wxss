page {
  height: 100%;
  background: #f4f6fb;
}

.game-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 32rpx calc(44rpx + env(safe-area-inset-bottom));
  background: #f4f6fb;
  box-sizing: border-box;
}

.game-header {
  flex: 0 0 calc(var(--menu-button-top) + var(--menu-button-height) + 24rpx);
  height: calc(var(--menu-button-top) + var(--menu-button-height) + 24rpx);
  padding-top: var(--menu-button-top);
  box-sizing: border-box;
}

.game-nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--menu-button-height);
}

.game-back {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--menu-button-height);
  height: var(--menu-button-height);
}

.game-page-title {
  color: #182743;
  font-size: 36rpx;
  font-weight: 800;
}

.game-hero {
  display: block;
  flex: 0 0 292rpx;
  width: 100%;
  height: 292rpx;
  overflow: hidden;
  border-radius: 22rpx;
  box-shadow: 0 14rpx 32rpx rgba(24, 39, 67, 0.18);
}

.game-list {
  flex: 1;
  min-height: 0;
  padding-top: 24rpx;
}

.game-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 12rpx 30rpx rgba(24, 39, 67, 0.08);
}

.game-card-head,
.game-card-footer {
  display: flex;
  align-items: center;
  width: 100%;
}

.game-card-head {
  position: relative;
  align-items: flex-start;
}

.game-card-footer {
  justify-content: space-between;
  align-items: center;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf0f5;
}

.game-icon {
  display: flex;
  flex: 0 0 104rpx;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
  font-size: 58rpx;
}

.game-icon.blue { background: #e8efff; }
.game-icon.orange { background: #fff0df; }
.game-icon.green { background: #e5f7ee; }

.game-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 22rpx;
  padding-right: 156rpx;
  box-sizing: border-box;
}

.game-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.game-title {
  color: #182743;
  font-size: 32rpx;
  font-weight: 800;
}

.game-rule {
  margin-left: 12rpx;
  padding: 4rpx 10rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #eef2f7;
  color: #61718a;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 19rpx;
  font-weight: 700;
}

.game-description {
  display: -webkit-box;
  width: calc(100% + 156rpx);
  margin-top: 10rpx;
  overflow: hidden;
  color: #8c96a6;
  font-size: 23rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.game-points {
  display: flex;
  align-items: baseline;
}

.game-points-label {
  margin-right: 10rpx;
  color: #7a8495;
  font-size: 22rpx;
}

.game-points-value {
  color: #ff8f00;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  animation: game-points-glow 1.8s ease-in-out infinite;
}

.game-points-unit {
  display: none;
}

.game-limits {
  position: absolute;
  top: 4rpx;
  right: 0;
  display: flex;
  flex: 0 0 auto;
  gap: 10rpx;
  margin: 4rpx 0 0 16rpx;
}

.game-limit {
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #f2f5f9;
  color: #68778e;
  font-size: 19rpx;
  line-height: 1.2;
}

.game-start {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 56rpx;
  margin-left: 18rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: #182743;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  box-sizing: border-box;
}

@keyframes game-points-glow {
  0%,
  100% {
    text-shadow: 0 0 6rpx rgba(255, 202, 40, 0.38), 0 0 14rpx rgba(255, 143, 0, 0.16);
  }

  50% {
    text-shadow: 0 0 16rpx rgba(255, 202, 40, 0.92), 0 0 28rpx rgba(255, 143, 0, 0.66);
  }
}

.game-start text {
  position: relative;
  z-index: 1;
}

.game-start-glow {
  position: absolute;
  inset: -10rpx;
  z-index: 0;
  border-radius: 36rpx;
  background: linear-gradient(90deg, rgba(87, 137, 236, 0.68), rgba(93, 204, 183, 0.56));
  filter: blur(12rpx);
  animation: game-start-glow 1.8s ease-in-out infinite;
}

@keyframes game-start-glow {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.92);
  }

  50% {
    opacity: 0.85;
    transform: scale(1.08);
  }
}
