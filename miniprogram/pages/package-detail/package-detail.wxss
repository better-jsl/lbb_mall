page {
  height: 100%;
  background: #f4f6fb;
  overflow: hidden;
}

.detail-page {
  height: 100vh;
  background: #f4f6fb;
  overflow: hidden;
}

.detail-scroll {
  height: 100%;
  padding-bottom: calc(178rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  position: relative;
  height: calc(460rpx + var(--menu-button-bottom));
  overflow: hidden;
  background: #182743;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

.hero-fade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  height: 38%;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(244, 246, 251, 0), #f4f6fb 96%);
}

.hero-indicators {
  position: absolute;
  bottom: 128rpx;
  left: 50%;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 10rpx;
  transform: translateX(-50%);
}

.hero-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.52);
}

.hero-indicator.active {
  width: 28rpx;
  background: #ffffff;
}

.detail-nav-shell {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 5;
  pointer-events: none;
}

.detail-nav-background {
  position: absolute;
  inset: 0;
  background: #182743;
  transition: opacity 120ms linear;
}

.floating-nav {
  position: absolute;
  left: 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  pointer-events: auto;
}

.floating-nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.36);
}

.detail-nav {
  position: absolute;
  top: calc(var(--menu-button-bottom) + 16rpx);
  left: 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.detail-nav-title {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.36);
}

.hero-caption {
  position: absolute;
  bottom: 142rpx;
  left: 50rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

.detail-content {
  position: relative;
  z-index: 1;
  margin-top: -122rpx;
  padding: 0 28rpx;
}

.summary-card,
.detail-card {
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(24, 39, 67, 0.08);
}

.summary-card {
  padding: 28rpx 30rpx 26rpx;
}

.summary-heading,
.summary-price-row,
.points-gift,
.content-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-title {
  max-width: 500rpx;
  overflow: hidden;
  color: #182743;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 46rpx;
  font-weight: 900;
}

.availability {
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: #edf3ff;
  color: #3261a1;
  font-size: 22rpx;
  font-weight: 700;
}

.summary-note {
  display: block;
  margin-top: 16rpx;
  color: #7a8495;
  font-size: 26rpx;
}

.summary-price-row {
  margin-top: 24rpx;
  align-items: flex-end;
}

.price-label,
.summary-points {
  color: #7a8495;
  font-size: 24rpx;
}

.price-label {
  display: block;
  margin-bottom: 10rpx;
}

.summary-price {
  color: #e4424a;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 0.9;
}

.summary-currency {
  margin-right: 6rpx;
  font-size: 34rpx;
}

.summary-points {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  padding-bottom: 8rpx;
}

.summary-points-value {
  color: #ffd262;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1;
  animation: detail-points-glow 1.8s ease-in-out infinite;
}

@keyframes detail-points-glow {
  0%,
  100% {
    text-shadow: 0 0 6rpx rgba(255, 210, 98, 0.32);
  }

  50% {
    text-shadow: 0 0 18rpx rgba(255, 210, 98, 0.94);
  }
}

.detail-card {
  margin-top: 26rpx;
  padding: 32rpx 28rpx;
}

.section-title {
  position: relative;
  display: block;
  padding-left: 26rpx;
  color: #182743;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.section-title::before {
  position: absolute;
  top: 4rpx;
  left: 0;
  width: 10rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #245a9e;
  content: '';
}

.content-row {
  min-height: 84rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.row-index {
  width: 64rpx;
  color: #a3abba;
  font-size: 24rpx;
}

.row-name {
  flex: 1;
  color: #43536b;
  font-size: 29rpx;
}

.row-count {
  color: #285b99;
  font-size: 28rpx;
  font-weight: 700;
}

.points-gift {
  min-height: 106rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.gift-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.gift-note {
  margin-top: 8rpx;
  color: #9aa3b2;
  font-size: 21rpx;
}

.gift-points {
  color: #23599e;
  font-size: 40rpx;
  font-weight: 900;
}

.no-border {
  border-bottom: 0;
}

.notice-card {
  margin-bottom: 12rpx;
}

.notice-line {
  display: block;
  margin-top: 24rpx;
  padding-left: 22rpx;
  color: #6f7c90;
  font-size: 26rpx;
  line-height: 1.55;
  text-indent: -20rpx;
}

.notice-line::before {
  content: '•';
  margin-right: 12rpx;
  color: #245a9e;
}

.purchase-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -6rpx 22rpx rgba(24, 39, 67, 0.06);
}

.purchase-price {
  padding-left: 0;
  color: #e4424a;
  font-size: 34rpx;
  font-weight: 900;
}

.purchase-price-value {
  margin-left: 6rpx;
  font-size: 58rpx;
}

.purchase-button {
  position: absolute;
  top: 20rpx;
  right: 28rpx;
  display: flex;
  width: 300rpx;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #182743;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
  animation: purchase-glow 1.8s ease-in-out infinite;
}

.purchase-button::after {
  border: 0;
}

@keyframes purchase-glow {
  0%,
  100% {
    box-shadow: 0 0 10rpx rgba(24, 39, 67, 0.2);
  }

  50% {
    box-shadow: 0 0 24rpx rgba(24, 39, 67, 0.58);
  }
}
