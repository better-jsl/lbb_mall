page {
  min-height: 100vh;
  background: #f4f6fb;
}

.points-page {
  min-height: 100vh;
  padding: var(--menu-button-top) 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-header {
  display: flex;
  align-items: center;
  height: var(--menu-button-height);
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: -10rpx;
}

.page-title {
  margin-left: 14rpx;
  color: #182743;
  font-size: 44rpx;
  font-weight: 800;
}

.points-summary {
  display: flex;
  flex-direction: column;
  margin-top: 34rpx;
  padding: 34rpx 32rpx;
  border-radius: 28rpx;
  background: #182743;
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(24, 39, 67, 0.16);
}

.summary-label {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
}

.summary-value {
  margin-top: 10rpx;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-note {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.record-list {
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(24, 39, 67, 0.07);
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  padding: 0 28rpx;
}

.record-item + .record-item {
  border-top: 1rpx solid #eef1f6;
}

.record-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.record-title {
  color: #182743;
  font-size: 29rpx;
  font-weight: 700;
}

.record-time {
  margin-top: 10rpx;
  color: #8a94a5;
  font-size: 23rpx;
}

.record-points {
  margin-left: 24rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.record-points.income {
  color: #17815d;
}

.record-points.expense {
  color: #d65a63;
}
