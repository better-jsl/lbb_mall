page {
  min-height: 100vh;
  background: #f4f6fb;
}

.coupons-page {
  min-height: 100vh;
  padding: var(--menu-button-top) 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-header {
  display: flex;
  align-items: center;
  height: var(--menu-button-height);
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: -10rpx;
}

.page-title {
  margin-left: 14rpx;
  color: #182743;
  font-size: 44rpx;
  font-weight: 800;
}

.coupon-tabs {
  margin-top: 30rpx;
  --td-brand-color: #182743;
  --td-tab-nav-bg-color: transparent;
  --td-bg-color-container: transparent;
}

.coupon-list {
  margin-top: 24rpx;
}

.coupon-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 154rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(24, 39, 67, 0.07);
}

.coupon-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 172rpx;
  border-left: 1rpx dashed #dce2eb;
  content: '';
}

.coupon-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  width: 148rpx;
  color: #245a9e;
  font-size: 52rpx;
  font-weight: 900;
}

.coupon-currency {
  margin-right: 4rpx;
  font-size: 28rpx;
}

.coupon-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 28rpx;
}

.coupon-title {
  overflow: hidden;
  color: #182743;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
  font-weight: 800;
}

.coupon-note,
.coupon-date {
  margin-top: 9rpx;
  color: #7a8495;
  font-size: 22rpx;
}

.coupon-state {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  color: #245a9e;
  font-size: 22rpx;
  font-weight: 700;
}

.coupon-card.used,
.coupon-card.expired {
  opacity: 0.62;
}

.coupon-card.used .coupon-value,
.coupon-card.used .coupon-state {
  color: #7a8495;
}

.coupon-card.expired .coupon-value,
.coupon-card.expired .coupon-state {
  color: #b18b62;
}
