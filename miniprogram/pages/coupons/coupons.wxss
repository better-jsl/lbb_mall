page {
  min-height: 100vh;
  background: #f4f6fb;
}

.coupons-page {
  min-height: 100vh;
  padding: var(--menu-button-top) 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-header {
  display: flex;
  align-items: center;
  height: var(--menu-button-height);
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: -10rpx;
}

.page-title {
  margin-left: 14rpx;
  color: #182743;
  font-size: 44rpx;
  font-weight: 800;
}

.coupon-tabs {
  margin: 8rpx -4rpx 28rpx;
}

.coupon-list {
  margin-top: 0;
}

.coupon-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 154rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(24, 39, 67, 0.07);
}

.coupon-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 172rpx;
  border-left: 1rpx dashed #dce2eb;
  content: '';
}

.coupon-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  width: 148rpx;
  color: #245a9e;
  font-size: 52rpx;
  font-weight: 900;
}

.coupon-currency {
  margin-right: 4rpx;
  font-size: 28rpx;
}

.coupon-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 28rpx;
}

.coupon-title {
  overflow: hidden;
  color: #182743;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
  font-weight: 800;
}

.coupon-note,
.coupon-date {
  margin-top: 9rpx;
  color: #7a8495;
  font-size: 22rpx;
}

.coupon-state {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  color: #245a9e;
  font-size: 22rpx;
  font-weight: 700;
}

.coupon-card.used,
.coupon-card.expired {
  opacity: 0.62;
}

.coupon-card.is-app-voucher {
  cursor: pointer;
}

.coupon-dialog-layer {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(24, 39, 67, 0.18);
  box-sizing: border-box;
}

.coupon-dialog-wrap {
  position: relative;
  width: 100%;
}

.coupon-dialog-close {
  position: absolute;
  top: -72rpx;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #5d6a7e;
}

.coupon-dialog {
  width: 100%;
  padding: 44rpx 40rpx 36rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 64rpx rgba(24, 39, 67, 0.2);
  box-sizing: border-box;
}

.coupon-dialog-title {
  display: block;
  color: #182743;
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
}

.coupon-dialog-warning {
  display: block;
  margin-top: 16rpx;
  color: #e34d59;
  text-align: center;
  font-size: 23rpx;
  line-height: 36rpx;
}

.coupon-phone-input {
  width: 100%;
  height: 84rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 16rpx;
  background: #f1f3f6;
  box-sizing: border-box;
  color: #182743;
  font-size: 28rpx;
}

.coupon-dialog-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 34rpx;
  border-radius: 44rpx;
  background: #182743;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

.coupon-card.used .coupon-value,
.coupon-card.used .coupon-state {
  color: #7a8495;
}

.coupon-card.expired .coupon-value,
.coupon-card.expired .coupon-state {
  color: #b18b62;
}
