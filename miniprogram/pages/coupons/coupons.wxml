<network-error wx:if="{{networkError}}" bind:retry="retryNetwork" />
<view class="coupons-page" hidden="{{networkError}}" style="--menu-button-top: {{menuButtonTop}}px; --menu-button-height: {{menuButtonHeight}}px;">
  <view class="page-header">
    <view class="back-button" bindtap="goBack">
      <t-icon name="chevron-left" size="44rpx" color="#182743" />
    </view>
    <text class="page-title">优惠券</text>
  </view>

  <t-tabs class="coupon-tabs standard-tabs" value="{{activeStatus}}" theme="line" bind:change="selectStatus">
    <t-tab-panel label="待使用" value="available"></t-tab-panel>
    <t-tab-panel label="已使用" value="used"></t-tab-panel>
    <t-tab-panel label="已过期" value="expired"></t-tab-panel>
  </t-tabs>

  <view class="coupon-list">
    <view wx:for="{{coupons}}" wx:key="id" class="coupon-card {{item.state}} {{item.isAppVoucher ? 'is-app-voucher' : ''}}" data-index="{{index}}" bindtap="openCoupon">
      <view class="coupon-value">
        <text class="coupon-currency">¥</text>
        <text>{{item.value}}</text>
      </view>
      <view class="coupon-copy">
        <text class="coupon-title">{{item.title}}</text>
        <text class="coupon-note">{{item.note}}</text>
        <text class="coupon-date">{{item.date}}</text>
      </view>
      <text class="coupon-state">{{item.status}}</text>
    </view>
  </view>

  <view wx:if="{{showAppVoucherDialog && selectedAppVoucher}}" class="coupon-dialog-layer" catchtap="closeAppVoucherDialog">
    <view class="coupon-dialog-wrap" catchtap="preventDialogClose">
      <view class="coupon-dialog-close" catchtap="closeAppVoucherDialog"><t-icon name="close" size="36rpx" /></view>
      <view class="coupon-dialog">
        <text class="coupon-dialog-title">使用 App 抵用券</text>
        <text class="coupon-dialog-warning">*输入错误导致未能领取本平台将不负责。</text>
        <input class="coupon-phone-input" type="number" maxlength="11" placeholder="请输入乐伴伴 App 登录手机号" value="{{appVoucherPhone}}" bindinput="onAppVoucherPhoneInput" />
        <view class="coupon-dialog-confirm" bindtap="claimAppVoucher"><text>{{claimingAppVoucher ? '提交中...' : '确认领取'}}</text></view>
      </view>
    </view>
  </view>
</view>
