page {
  min-height: 100vh;
  background: #f4f6fb;
}

.mine-page {
  min-height: 100vh;
  padding: 0 32rpx calc(146rpx + env(safe-area-inset-bottom));
}

.mine-header {
  height: calc(var(--menu-button-top) + var(--menu-button-height) + 24rpx);
  padding-top: var(--menu-button-top);
  box-sizing: border-box;
}

.mine-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--menu-button-height);
}

.mine-page-title {
  color: #182743;
  font-size: 36rpx;
  font-weight: 800;
}

.profile {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 40rpx;
  background: #182743;
  color: #fff;
  box-shadow: 0 18rpx 42rpx rgba(24, 39, 67, 0.16);
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.profile-text {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding-right: 168rpx;
}

.verification-action {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
}

.profile-subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 128rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(24, 39, 67, 0.07);
}

.stat-value {
  color: #182743;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.stat-label {
  margin-top: 10rpx;
  color: #7a8495;
  font-size: 23rpx;
}

.entry-list {
  margin: 28rpx 0;
  overflow: hidden;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(24, 39, 67, 0.07);
}

.entry-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 100rpx;
  padding: 0 24rpx;
  color: #182743;
  font-size: 28rpx;
  font-weight: 600;
}

.entry-item + .entry-item {
  border-top: 1rpx solid #eef1f6;
}

.entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #eef2f8;
}

.entry-item text:nth-child(2) {
  flex: 1;
}

.entry-label {
  flex: 1;
}

.entry-summary {
  max-width: 280rpx;
  overflow: hidden;
  color: #8d98a9;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 400;
}

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 36rpx;
  border: 1rpx solid #d7dee9;
  border-radius: 44rpx;
  background: #ffffff;
  color: #5d6a7e;
  font-size: 28rpx;
}

.logout-button::after {
  border: 0;
}
