page {
  min-height: 100%;
  background: #f4f6fb;
}

.daily-page {
  min-height: 100vh;
  padding: 0 32rpx calc(44rpx + env(safe-area-inset-bottom));
  background: #f4f6fb;
  box-sizing: border-box;
}

.daily-header {
  height: calc(var(--menu-button-top) + var(--menu-button-height) + 26rpx);
  padding-top: var(--menu-button-top);
  box-sizing: border-box;
}

.daily-nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--menu-button-height);
}

.daily-back {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--menu-button-height);
  height: var(--menu-button-height);
}

.daily-page-title {
  color: #182743;
  font-size: 36rpx;
  font-weight: 800;
}

.daily-task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 18rpx;
}

.daily-task-card {
  display: flex;
  align-items: center;
  min-height: 148rpx;
  padding: 24rpx 24rpx 24rpx 28rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(24, 39, 67, 0.08);
  box-sizing: border-box;
}

.daily-task-icon {
  display: flex;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  font-size: 52rpx;
  line-height: 1;
}

.daily-task-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 22rpx;
}

.daily-task-title {
  color: #182743;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.daily-task-reward {
  margin-top: 10rpx;
  color: #ff8f00;
  font-size: 24rpx;
  font-weight: 700;
}

.daily-task-action {
  display: flex;
  flex: 0 0 142rpx;
  align-items: center;
  justify-content: center;
  width: 142rpx;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 35rpx;
  background: #182743;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 70rpx;
  box-shadow: 0 8rpx 18rpx rgba(24, 39, 67, 0.22);
}

.daily-task-action::after {
  border: 0;
}

.daily-task-action.is-completed {
  background: #dce3ee;
  box-shadow: none;
}
