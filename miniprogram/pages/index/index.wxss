page {
  height: 100%;
  background: #f4f6fb;
  overflow: hidden;
}

.mall-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 20rpx calc(146rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, rgba(24, 39, 67, 0.04), rgba(244, 246, 251, 0) 360rpx),
    #f4f6fb;
  overflow: hidden;
}

.topbar {
  display: flex;
  align-items: flex-start;
  flex: 0 0 calc(160rpx + var(--menu-button-top));
  height: calc(160rpx + var(--menu-button-top));
  padding: var(--menu-button-top) 0 0;
}

.brand {
  display: flex;
  width: 330rpx;
  height: 150rpx;
  min-width: 0;
}

.brand-image {
  width: 100%;
  height: 100%;
}

.shop-body {
  display: flex;
  flex: 1;
  gap: 34rpx;
  min-height: 0;
}

.category-list {
  flex: 0 0 160rpx;
  height: 100%;
  padding-top: 20rpx;
}

.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 102rpx;
  margin-bottom: 22rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #182743;
  box-shadow: 0 10rpx 28rpx rgba(24, 39, 67, 0.08);
}

.category-card.active {
  height: 100rpx;
  background: #173f86;
  color: #fff;
  box-shadow: 0 16rpx 32rpx rgba(23, 63, 134, 0.22);
}

.category-name {
  max-width: 132rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
}

.category-pinyin {
  max-width: 132rpx;
  margin-top: 8rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(24, 39, 67, 0.48);
  font-size: 22rpx;
  line-height: 1.1;
}

.category-card.active .category-pinyin {
  color: rgba(255, 255, 255, 0.62);
}

.package-list {
  flex: 1;
  height: 100%;
  min-width: 0;
  padding: 26rpx 0 24rpx;
}

.package-card {
  position: relative;
  display: flex;
  justify-content: space-between;
  min-height: 300rpx;
  margin-bottom: 28rpx;
  padding: 42rpx 26rpx 32rpx 32rpx;
  overflow: hidden;
  border-radius: 20rpx;
  color: #fff;
  box-shadow: 0 18rpx 28rpx rgba(24, 39, 67, 0.13);
}

.package-card::before,
.package-card::after {
  position: absolute;
  content: "";
}

.package-card::before {
  inset: 0;
  opacity: 0.95;
}

.package-card::after {
  right: -44rpx;
  bottom: -38rpx;
  width: 270rpx;
  height: 210rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 46% 54% 40% 60%;
  background: rgba(255, 255, 255, 0.06);
  transform: rotate(-14deg);
}

.package-card.whiskey::before {
  background:
    radial-gradient(circle at 78% 46%, rgba(255, 255, 255, 0.16), transparent 0 104rpx),
    linear-gradient(90deg, rgba(11, 44, 100, 0.98), rgba(11, 44, 100, 0.78)),
    #0b2c64;
}

.package-card.lager::before {
  background:
    radial-gradient(circle at 62% 45%, rgba(249, 216, 130, 0.16), transparent 0 116rpx),
    linear-gradient(90deg, rgba(0, 98, 79, 0.97), rgba(0, 98, 79, 0.78)),
    #00624f;
}

.package-card.ruby::before {
  background:
    radial-gradient(circle at 62% 56%, rgba(255, 197, 90, 0.18), transparent 0 120rpx),
    linear-gradient(90deg, rgba(117, 29, 34, 0.98), rgba(117, 29, 34, 0.82)),
    #751d22;
}

.package-card.club::before {
  background:
    radial-gradient(circle at 58% 48%, rgba(37, 207, 216, 0.18), transparent 0 124rpx),
    linear-gradient(90deg, rgba(8, 56, 122, 0.98), rgba(8, 56, 122, 0.78)),
    #08387a;
}

.package-text,
.price-area {
  position: relative;
  z-index: 1;
}

.package-text {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.package-title {
  max-width: 400rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.16;
}

.gift-area {
  margin-top: 78rpx;
}

.gift-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 52rpx;
  height: 40rpx;
  margin-bottom: 12rpx;
  padding: 0 12rpx;
  border-radius: 7rpx;
  background: #f6be45;
  color: #182743;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.gift-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 1.25;
}

.gift-dot {
  flex: 0 0 15rpx;
  width: 15rpx;
  height: 15rpx;
  border-radius: 999rpx;
  background: #ffd262;
  box-shadow: 0 0 10rpx rgba(255, 210, 98, 0.9);
}

.price-area {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  align-self: center;
  min-width: 144rpx;
  padding-top: 24rpx;
}

.price-line {
  display: flex;
  align-items: baseline;
  white-space: nowrap;
}

.currency {
  margin-right: 4rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.price {
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1;
}

.points-label {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.points {
  margin-top: 4rpx;
  color: #ffd262;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  animation: points-glow 1.8s ease-in-out infinite;
}

@keyframes points-glow {
  0%,
  100% {
    text-shadow: 0 0 6rpx rgba(255, 210, 98, 0.32);
  }

  50% {
    text-shadow: 0 0 18rpx rgba(255, 210, 98, 0.94);
  }
}

.package-enter {
  animation: package-slide-in 360ms ease-out both;
}

.package-prepared {
  opacity: 0;
  transform: translateX(750rpx);
}

.package-enter:nth-child(2) {
  animation-delay: 100ms;
}

.package-enter:nth-child(3) {
  animation-delay: 200ms;
}

.package-enter:nth-child(4) {
  animation-delay: 300ms;
}

@keyframes package-slide-in {
  0% {
    opacity: 0;
    transform: translateX(750rpx);
  }

  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@media (max-width: 360px) {
  .topbar {
    flex-basis: calc(154rpx + var(--menu-button-top));
    height: calc(154rpx + var(--menu-button-top));
  }

  .mall-page {
    padding-left: 16rpx;
    padding-right: 16rpx;
  }

  .shop-body {
    gap: 20rpx;
  }

  .category-list {
    flex-basis: 146rpx;
  }

  .category-card {
    width: 146rpx;
  }

  .brand {
    width: 300rpx;
    height: 136rpx;
  }

  .package-card {
    padding-left: 26rpx;
  }

  .package-title {
    font-size: 38rpx;
  }

  .price {
    font-size: 54rpx;
  }
}
