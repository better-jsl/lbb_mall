<network-error wx:if="{{networkError}}" bind:retry="retryNetwork" />
<view class="mall-page" hidden="{{networkError}}">
  <view class="topbar" style="--menu-button-top: {{menuButtonTop}}px; --menu-button-height: {{menuButtonHeight}}px;">
    <view class="topbar-title-row"><text class="page-title">商城</text></view>
  </view>

  <t-tabs class="mall-tabs" value="{{activeMallTab}}" theme="line" bind:change="selectMallTab">
    <t-tab-panel label="严选商家" value="merchants"></t-tab-panel>
    <t-tab-panel label="积分兑换" value="exchange"></t-tab-panel>
  </t-tabs>

  <view wx:if="{{activeMallTab === 'merchants'}}" class="shop-body">
    <scroll-view class="category-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{merchants}}"
        wx:key="name"
        class="category-card {{activeMerchant == index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="selectMerchant"
      >
        <text class="category-name">{{item.name}}</text>
        <text class="category-pinyin">距你 {{item.distance}}km</text>
      </view>
    </scroll-view>

    <view class="package-list-area">
      <scroll-view class="package-list" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-default-style="none" refresher-triggered="{{packageRefreshing}}" bindrefresherpulling="onPackagePulling" bindrefresherrefresh="refreshPackages" bindrefresherrestore="onPackageRefreshRestore" bindrefresherabort="onPackageRefreshRestore" lower-threshold="80" bindscrolltolower="loadMorePackages">
      <view class="list-refresher {{packageRefreshing ? 'is-refreshing' : ''}}" style="opacity: {{packageRefreshing || packagePullScale > 0 ? 1 : 0}}; transform: translateY(-72rpx) scale({{(packageRefreshing ? 1 : packagePullScale) * 1.35}});">
        <view class="list-refresh-dot"></view><view class="list-refresh-dot"></view><view class="list-refresh-dot"></view>
        <text wx:if="{{packageRefreshing}}" class="list-refresh-label">正在刷新</text>
      </view>
      <block wx:if="{{packages.length}}">
      <view
        wx:for="{{packages}}"
        wx:key="id"
        class="package-card {{item.tone}} {{showPackageAnimation ? 'package-enter' : 'package-prepared'}}"
        style="animation-delay: {{index * 100}}ms;"
        data-id="{{item.id}}"
        data-title="{{item.title}}"
        data-price="{{item.price}}"
        data-points="{{item.points}}"
        bindtap="showPackageDetail"
      >
        <image wx:if="{{item.coverImage}}" class="package-cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="package-mask"></view>
        <view class="package-text">
          <text class="package-title">{{item.title}}</text>
          <view class="gift-area">
            <text class="gift-tag">{{item.tag}}</text>
            <view wx:for="{{item.gifts}}" wx:key="*this" wx:for-item="gift" class="gift-row">
              <view class="gift-dot"></view>
              <text>{{gift}}</text>
            </view>
          </view>
        </view>

        <view class="price-area">
          <view class="price-line">
            <text class="currency">¥</text>
            <text class="price">{{item.price}}</text>
          </view>
          <text class="points-label">赠送积分</text>
          <text class="points">{{item.points}}</text>
        </view>
      </view>
      <view wx:if="{{packageLoading}}" class="list-load-status">加载中...</view>
      <view wx:elif="{{!packageHasMore}}" class="list-load-status">没有更多套餐了</view>
      </block>
      <view wx:else class="package-empty-state">
        <view class="package-empty-illustration"><t-icon name="browse-off" size="92rpx" color="#9aa3b2" /></view>
        <text class="package-empty-title">该商家暂未上架套餐</text>
        <text class="package-empty-description">敬请期待</text>
      </view>
      </scroll-view>
      <view wx:if="{{packages.length}}" class="package-list-fade package-list-fade-top"></view>
      <view wx:if="{{packages.length}}" class="package-list-fade package-list-fade-bottom"></view>
    </view>
  </view>

  <view wx:else class="exchange-section">
    <view class="exchange-toolbar">
      <view class="affordable-filter">
        <switch class="affordable-filter-switch" checked="{{showAffordableOnly}}" color="#182743" bindchange="toggleAffordableOnly" />
        <text class="affordable-filter-label">仅看可兑换</text>
      </view>
      <view class="exchange-summary">我的积分：<text class="exchange-summary-value">{{userPoints}}</text></view>
    </view>
    <view class="exchange-body">
      <scroll-view class="exchange-category-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:for="{{exchangeCategories}}" wx:key="id" class="exchange-category-card {{activeExchangeCategory == index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectExchangeCategory">
          <text class="exchange-category-emoji">{{item.emoji}}</text>
          <text class="exchange-category-name">{{item.label}}</text>
        </view>
      </scroll-view>

      <scroll-view class="exchange-list" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-default-style="none" refresher-triggered="{{exchangeRefreshing}}" bindrefresherpulling="onExchangePulling" bindrefresherrefresh="refreshExchangeProducts" bindrefresherrestore="onExchangeRefreshRestore" bindrefresherabort="onExchangeRefreshRestore" lower-threshold="80" bindscrolltolower="loadMoreExchangeProducts">
        <view class="list-refresher {{exchangeRefreshing ? 'is-refreshing' : ''}}" style="opacity: {{exchangeRefreshing || exchangePullScale > 0 ? 1 : 0}}; transform: translateY(-72rpx) scale({{(exchangeRefreshing ? 1 : exchangePullScale) * 1.35}});">
          <view class="list-refresh-dot"></view><view class="list-refresh-dot"></view><view class="list-refresh-dot"></view>
          <text wx:if="{{exchangeRefreshing}}" class="list-refresh-label">正在刷新</text>
        </view>
        <block wx:if="{{exchangeItems.length}}">
        <view wx:for="{{exchangeItems}}" wx:key="id" class="exchange-card" data-index="{{index}}" bindtap="openExchangeDialog">
          <view class="exchange-icon"><text>{{item.emoji}}</text></view>
          <view class="exchange-copy">
            <scroll-view class="exchange-title-scroll" scroll-x enhanced show-scrollbar="{{false}}">
              <text class="exchange-title">{{item.title}}</text>
            </scroll-view>
            <view class="exchange-value-row">
              <text class="exchange-value">价值{{item.value}}元</text>
              <text class="exchange-method">{{item.redemptionMethod}}</text>
            </view>
            <view class="exchange-action">
              <view class="exchange-points">
                <text>{{item.points}}</text>
                <text class="exchange-unit">积分</text>
              </view>
              <view class="redeem-button" data-index="{{index}}" catchtap="openExchangeDialog"><text>兑换</text></view>
            </view>
          </view>
        </view>
        <view wx:if="{{exchangeLoading}}" class="list-load-status">加载中...</view>
        <view wx:elif="{{!exchangeHasMore}}" class="list-load-status">没有更多物品了</view>
        </block>
      <view wx:else class="exchange-empty-state">
        <view class="exchange-empty-illustration"><t-icon name="browse-off" size="92rpx" color="#9aa3b2" /></view>
        <text class="exchange-empty-title">暂无可兑换物品</text>
        <text class="exchange-empty-description">继续攒积分再来看看</text>
      </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{showExchangeDialog && selectedExchangeItem}}" class="exchange-dialog-layer" catchtap="closeExchangeDialog">
    <view class="exchange-dialog" catchtap="preventDialogClose">
      <view class="exchange-dialog-icon"><text>{{selectedExchangeItem.emoji}}</text></view>
      <text class="exchange-dialog-title">{{selectedExchangeItem.title}}</text>
      <text class="exchange-dialog-value">价值{{selectedExchangeItem.value}}元</text>
      <view class="exchange-dialog-points">
        <text>{{selectedExchangeItem.points}}</text>
        <text class="exchange-dialog-unit">积分</text>
      </view>
      <view class="exchange-dialog-divider"></view>
      <text class="exchange-dialog-note">兑换后可在我的订单中查看</text>
      <view class="exchange-dialog-confirm" bindtap="redeemExchange"><text>立即兑换</text></view>
    </view>
  </view>

  <view wx:if="{{showShippingDialog && selectedExchangeItem && shippingAddress}}" class="exchange-dialog-layer" catchtap="closeShippingDialog">
    <view class="exchange-dialog shipping-dialog" catchtap="preventDialogClose">
      <view class="exchange-dialog-icon"><text>{{selectedExchangeItem.emoji}}</text></view>
      <text class="exchange-dialog-title">{{selectedExchangeItem.title}}</text>
      <view class="exchange-dialog-points shipping-points">
        <text>{{selectedExchangeItem.points}}</text>
        <text class="exchange-dialog-unit">积分</text>
      </view>
      <view class="exchange-dialog-divider"></view>
      <text class="shipping-title">确认邮寄到以下地址？</text>
      <view class="shipping-address-card">
        <text class="shipping-contact">{{shippingContactText}}</text>
        <text class="shipping-address">{{shippingAddressText}}</text>
      </view>
      <view class="shipping-actions">
        <view class="shipping-edit" bindtap="editShippingAddress"><text>修改地址</text></view>
        <view class="shipping-confirm" bindtap="confirmShippingExchange"><text>确认邮寄</text></view>
      </view>
    </view>
  </view>
</view>
