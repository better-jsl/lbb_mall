page {
  min-height: 100vh;
  background: #f4f6fb;
}

.order-detail-page {
  min-height: 100vh;
  padding: var(--menu-button-top) 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-header {
  display: flex;
  align-items: center;
  height: var(--menu-button-height);
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: -10rpx;
}

.page-title {
  margin-left: 14rpx;
  color: #182743;
  font-size: 44rpx;
  font-weight: 800;
}

.status-card {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #182743;
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(24, 39, 67, 0.16);
}

.status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
}

.status-copy {
  display: flex;
  flex-direction: column;
  margin-left: 22rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 800;
}

.status-note {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.detail-card {
  margin-top: 26rpx;
  padding: 30rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(24, 39, 67, 0.07);
}

.card-title {
  display: block;
  color: #182743;
  font-size: 32rpx;
  font-weight: 800;
}

.package-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
}

.package-title,
.package-merchant {
  display: block;
}

.package-title {
  max-width: 390rpx;
  overflow: hidden;
  color: #182743;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 700;
}

.package-merchant {
  margin-top: 10rpx;
  color: #7a8495;
  font-size: 24rpx;
}

.package-price {
  color: #e4424a;
  font-size: 38rpx;
  font-weight: 900;
}

.package-content-list {
  margin-top: 24rpx;
  border-top: 1rpx solid #eef1f6;
}

.package-content-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.package-content-row:last-child {
  border-bottom: 0;
}

.content-name {
  color: #43536b;
  font-size: 27rpx;
}

.content-count {
  color: #285b99;
  font-size: 27rpx;
  font-weight: 700;
}

.content-value {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.use-points-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 52rpx;
  border: 1rpx solid #182743;
  border-radius: 999rpx;
  background: #ffffff;
  color: #182743;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  border-bottom: 1rpx solid #eef1f6;
  color: #7a8495;
  font-size: 26rpx;
}

.info-row text:last-child {
  color: #43536b;
  font-weight: 600;
}

.info-row.no-border {
  border-bottom: 0;
}

.info-row text.payment {
  color: #e4424a;
  font-size: 34rpx;
  font-weight: 900;
}
