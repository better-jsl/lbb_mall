<t-tab-bar
  class="mall-tabbar"
  value="{{selected}}"
  fixed="{{true}}"
  placeholder="{{true}}"
  safe-area-inset-bottom="{{true}}"
  bordered="{{false}}"
  split="{{false}}"
  shape="round"
  theme="tag"
  style="bottom: calc(16rpx + env(safe-area-inset-bottom));"
  bind:change="onTabChange"
>
  <t-tab-bar-item
    wx:for="{{tabs}}"
    wx:key="pagePath"
    value="{{index}}"
    icon="{{item.icon}}"
  >
    {{item.text}}
  </t-tab-bar-item>
</t-tab-bar>
