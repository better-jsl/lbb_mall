.login-profile-layer {
  position: fixed;
  z-index: 2000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(24, 39, 67, 0.28);
}

.login-profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 52rpx 44rpx 44rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 64rpx rgba(24, 39, 67, 0.2);
}

.login-profile-title {
  color: #182743;
  font-size: 38rpx;
  font-weight: 800;
}

.login-profile-note {
  margin-top: 12rpx;
  color: #7a8495;
  font-size: 24rpx;
}

.login-avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 132rpx;
  width: 132rpx;
  min-width: 132rpx;
  height: 132rpx;
  min-height: 132rpx;
  margin-top: 36rpx;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 132rpx;
}

.login-avatar-button::after,
.login-phone-button::after {
  border: 0;
}

.login-avatar-image {
  width: 100%;
  height: 100%;
}

.login-avatar-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #eef2f8;
}

.login-avatar-placeholder {
  color: #5d6a7e;
  font-size: 24rpx;
}

.login-nickname-input {
  width: 100%;
  height: 84rpx;
  margin-top: 30rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f1f3f6;
  color: #182743;
  font-size: 28rpx;
  box-sizing: border-box;
}

.login-phone-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  border-radius: 44rpx;
  background: #182743;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

.login-phone-only {
  margin-top: 48rpx;
}
